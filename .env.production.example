# Copy to .env for a deployment and replace every placeholder before use.
# Never commit the resulting .env file.
# Use a long, randomly generated URL-safe value to avoid URL-escaping issues
# in the current PostgreSQL DSN assembled by docker-compose.yaml.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_SECRET

# Optional; keep empty to disable one-time web login codes.
# If enabled, use at least 32 characters and match the portal's PLAY_CODE_SECRET.
W2PP_PLAY_CODE_SECRET=
