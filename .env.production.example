# Copy to a protected environment file; do not commit real secrets.
# Use a long random URL-safe password because the DSN is assembled as a URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_SECRET

# Optional. If one-time web login codes are enabled, use the same secret as the portal.
# Keep it at least 32 characters and never commit a real value.
W2PP_PLAY_CODE_SECRET=
